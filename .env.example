# Web server
HOST=127.0.0.1
PORT=4173

# Provider: local | openai-compatible | anthropic | gemini
# local uses the bundled original item bank and does not call an LLM.
LLM_PROVIDER=local
LLM_TIMEOUT_MS=90000
LLM_MAX_TOKENS=2400

# OpenAI / OpenAI-compatible / vLLM / SGLang
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01

# Gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=
